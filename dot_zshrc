# Enable profiling only on demand: ZSH_PROFILE=1 zsh -i -c exit
[[ -n "$ZSH_PROFILE" ]] && zmodload zsh/zprof

# Powerlevel10k instant prompt (must stay near the top)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Keep only the first occurrence of each PATH entry
typeset -U path PATH

# Oh My Zsh configuration
export ZSH="$HOME/.oh-my-zsh"
export ZSH_COMPDUMP="$ZSH/cache/.zcompdump"   # stable name, independent of $HOST
ZSH_THEME="powerlevel10k/powerlevel10k"
HIST_STAMPS="%m/%d/%Y %T"
plugins=(git)
zstyle ':omz:update' mode disabled

# Extra completion dirs: must be registered BEFORE Oh My Zsh runs compinit
fpath=(~/.zfunc ~/.docker/completions $fpath)

source $ZSH/oh-my-zsh.sh

# Python paths
export PYTHONPATH='/_amplisim/_src/NUMFACTOR/PYTHON':'/_amplisim/_src/AMPLISIM':'/_amplisim/_src/DATASCIENCE/PYTHON':"$HOME/project/"

# Lazy-load conda: the hook only runs on the first `conda` call
conda() {
  unfunction conda
  local setup
  setup="$("$HOME/miniconda3/bin/conda" shell.zsh hook 2> /dev/null)" && eval "$setup"
  conda "$@"
}

# Colors
export CLICOLOR=1
export LSCOLORS=ExFxBxDxCxegedabagacad
alias grep='grep --color=auto'

# Tool integrations (cmd load if installed)
test -e "$HOME/.iterm2_shell_integration.zsh" && source "$HOME/.iterm2_shell_integration.zsh"

# fzf & atuin bind ctrl R keys thus order matters
command -v fzf    >/dev/null && source <(fzf --zsh)       # fuzzy finder
command -v direnv >/dev/null && eval "$(direnv hook zsh)" # src .envrc
command -v zoxide >/dev/null && eval "$(zoxide init zsh)" # cd based on freq
command -v atuin  >/dev/null && eval "$(atuin init zsh)"  # shell histo in db

# Powerlevel10k configuration (run `p10k configure` to edit)
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Print profiling report (only when ZSH_PROFILE is set)
[[ -n "$ZSH_PROFILE" ]] && zprof

